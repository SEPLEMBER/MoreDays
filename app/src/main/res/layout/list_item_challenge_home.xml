<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="challenge"
            type="de.wuapps.moredays.database.entity.Challenge" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/home_card_width"
        android:layout_height="@dimen/home_card_height"
        android:layout_margin="2dp"
        android:elevation="6dp"
        android:focusable="true"
        app:cardCornerRadius="8dp">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:id="@+id/imageViewIcon"
                android:layout_gravity="center_horizontal"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{challenge.title}"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewTitle"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:id="@+id/textViewDeadline"/>
            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:min="@{challenge.startValue}"
                android:max="@{challenge.desiredValue}"
                android:progress="@{challenge.currentValue}"
                android:id="@+id/progressBarCurrent"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>