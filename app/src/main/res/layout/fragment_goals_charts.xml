<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.charts.GoalsChartsFragment">

    <LinearLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.mikephil.charting.charts.CombinedChart
            android:id="@+id/combinedChartHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:minHeight="@dimen/bar_chart_height" />

        <com.github.mikephil.charting.charts.RadarChart
            android:id="@+id/radarChartDaysMade"
            android:layout_width="match_parent"
            android:layout_height="@dimen/radar_chart_height" />

        <TextView
            android:id="@+id/lblChartEntryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_activities" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChartActivities"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bar_chart_height" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/help_goal_chart_circles" />
    </LinearLayout>

</ScrollView>