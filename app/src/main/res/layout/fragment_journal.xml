<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="journalViewModel"
            type="de.wuapps.moredays.ui.journal.JournalViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/layout_margin"
        tools:context=".ui.journal.JournalFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/textsize_larger"
                android:text="@{journalViewModel.getCurrentDate()}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageViewPictureOfTheDay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="3:2"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewDate" />

            <ImageButton
                android:id="@+id/imageButtonPickImage"
                android:layout_width="@dimen/min_accesible_size"
                android:layout_height="@dimen/min_accesible_size"
                android:background="@drawable/circle_in_secondary"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_camera"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewDate" />

            <ImageButton
                android:id="@+id/imageButtonRemoveImage"
                android:layout_width="@dimen/min_accesible_size"
                android:layout_height="@dimen/min_accesible_size"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_in_secondary"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_delete"
                app:layout_constraintEnd_toStartOf="@id/imageButtonPickImage"
                app:layout_constraintTop_toBottomOf="@id/textViewDate" />

            <EditText
                android:id="@+id/editTextAffirmation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/title_affirmation"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="48dp"
                android:text="@={journalViewModel.journal.affirmation}"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/imageButtonSuggestAffirmation"
                app:layout_constraintTop_toBottomOf="@id/imageViewPictureOfTheDay" />

            <ImageButton
                android:id="@+id/imageButtonSuggestAffirmation"
                android:layout_width="@dimen/min_accesible_size"
                android:layout_height="@dimen/min_accesible_size"
                android:background="@drawable/circle_in_secondary"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lookup"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/editTextAffirmation" />

            <EditText
                android:id="@+id/editTextNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/notes"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="48dp"
                android:text="@={journalViewModel.journal.note}"
                android:textSize="@dimen/min_accesible_textsize"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/editTextAffirmation" />

            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMood1"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_1"
                android:text="@string/mood_face_1"
                android:background="@null"
                android:textSize="@dimen/mood_button_text_size"
                android:layout_marginTop="@dimen/min_accesible_size"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@id/buttonMood2"
                app:layout_constraintTop_toBottomOf="@id/editTextNote"
                 />


            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMood2"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_2"
                android:text="@string/mood_face_2"
                android:background="@null"
                android:textSize="@dimen/mood_button_text_size"
                app:layout_constraintEnd_toStartOf="@+id/buttonMood3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/buttonMood1"
                app:layout_constraintTop_toTopOf="@id/buttonMood1" />

            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMood3"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_3"
                android:text="@string/mood_face_3"
                android:textSize="@dimen/mood_button_text_size"
                android:background="@null"
                app:layout_constraintEnd_toStartOf="@+id/buttonMood4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/buttonMood2"
                app:layout_constraintTop_toTopOf="@id/buttonMood1" />


            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMood4"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_4"
                android:text="@string/mood_face_4"
                android:background="@null"
                android:textSize="@dimen/mood_button_text_size"
                app:layout_constraintEnd_toStartOf="@id/buttonMood5"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/buttonMood3"
                app:layout_constraintTop_toTopOf="@id/buttonMood1" />
            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMood5"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_5"
                android:text="@string/mood_face_5"
                android:background="@null"
                android:textSize="@dimen/mood_button_text_size"
                app:layout_constraintStart_toEndOf="@id/buttonMood4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@id/buttonMoodNone"
                app:layout_constraintTop_toTopOf="@id/buttonMood1"
                 />
            <androidx.emoji2.widget.EmojiButton
                android:id="@+id/buttonMoodNone"
                android:layout_width="@dimen/mood_button_size"
                android:layout_height="@dimen/mood_button_size"
                android:contentDescription="@string/mood_5"
                android:text="@string/no_mood"
                android:background="@null"
                android:textSize="@dimen/min_accesible_textsize"
                app:layout_constraintStart_toEndOf="@id/buttonMood5"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/buttonMood1"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>