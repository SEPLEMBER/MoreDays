<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="goalEntry"
            type="de.wuapps.moredays.ui.home.GoalEntry" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/home_card_width"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:elevation="0dp"
        android:focusable="true"
        android:minHeight="@dimen/home_card_height"
        android:padding="0dp"
        app:cardCornerRadius="0dp"
        android:onClick="@{clickListener}"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:minHeight="@dimen/home_card_height"
            android:padding="0dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewSymbol"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_weight="2"
                android:contentDescription="@{goalEntry.name}"
                 />

            <TextView
                android:id="@+id/textViewInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@{goalEntry.info}"
                android:layout_weight="1"
                android:textSize="@dimen/min_accesible_textsize"
                 />

            <ProgressBar
                android:id="@+id/progressBarCurrent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_margin="0dp"
                android:layout_gravity="bottom"
                android:max="@{goalEntry.desiredValue}"
                android:min="0"
                android:padding="0dp"
                android:progress="@{goalEntry.currentValue}"
                android:progressTint="@color/lime500"
                android:visibility="visible"
                 />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
