<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/layout_margin"
        app:flexWrap="wrap"
        tools:context=".ui.tools.ToolsFragment">

        <TextView
            android:id="@+id/textViewBaseData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/base_data"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

        <Button
            android:id="@+id/buttonGoals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/title_goals" />

        <Button
            android:id="@+id/buttonScales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/title_scales" />

        <TextView
            android:id="@+id/textViewLists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lists"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

        <Button
            android:id="@+id/buttonActivityEntries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/activity_entries" />

        <Button
            android:id="@+id/buttonTrophies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/title_trophies" />

        <TextView
            android:id="@+id/textViewTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_tools"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

        <Button
            android:id="@+id/buttonImportExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:visibility="gone"
            android:text="@string/import_export" />

        <Button
            android:id="@+id/buttonSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/title_settings" />

        <Button
            android:id="@+id/buttonHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/min_margin"
            android:text="@string/help" />

    </com.google.android.flexbox.FlexboxLayout>
</ScrollView>