<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="de.wuapps.moredays.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/navigation_tools"
        android:name="de.wuapps.moredays.ui.tools.ToolsFragment"
        android:label="ToolsFragment" >
        <action
            android:id="@+id/navigation_tools_goals"
            app:destination="@id/goalListFragment" />
        <action
            android:id="@+id/navigation_tools_challenges"
            app:destination="@id/challengeListFragment" />
        <action
            android:id="@+id/navigation_tools_scales"
            app:destination="@id/scaleListFragment" />
    </fragment>
    <fragment
        android:id="@+id/activityFragment"
        android:name="de.wuapps.moredays.ui.activity.ActivityFragment"
        android:label="activity_fragment"
        tools:layout="@layout/activity_fragment" >
        <argument
            android:name="activity"
            app:nullable="true"
            app:argType="de.wuapps.moredays.database.entity.Activity"
            android:defaultValue="@null" />
        <argument
            android:name="goal"
            app:nullable="false"
            app:argType="de.wuapps.moredays.database.entity.Goal"
             />
        <action
            android:id="@+id/navigation_activity_goal"
            app:destination="@id/goalFragment"
            app:popUpTo="@id/goalFragment"
            app:popUpToInclusive="true">
        <argument
            android:name="goal"
            app:nullable="false"
            app:argType="de.wuapps.moredays.database.entity.Goal"
            />
        </action>
    </fragment>
    <fragment
        android:id="@+id/challengeFragment"
        android:name="de.wuapps.moredays.ui.challenge.ChallengeFragment"
        android:label="challenge_fragment"
        tools:layout="@layout/challenge_fragment">
    <argument
        android:name="challengeId"
        app:argType="long"
        android:defaultValue="-1L"/>
    </fragment>
    <fragment
        android:id="@+id/goalFragment"
        android:name="de.wuapps.moredays.ui.goal.GoalFragment"
        android:label="goal_fragment"
        tools:layout="@layout/goal_fragment" >
        <argument
            android:name="goal"
            app:nullable="true"
            app:argType="de.wuapps.moredays.database.entity.Goal"
            android:defaultValue="@null" />
        <action
            android:id="@+id/navigation_goal_activity"
            app:destination="@id/activityFragment" />
    </fragment>
    <fragment
        android:id="@+id/navigation_charts"
        android:name="de.wuapps.moredays.ui.charts.ChartsFragment"
        android:label="charts_fragment"
        tools:layout="@layout/charts_fragment" />
    <fragment
        android:id="@+id/navigation_trophies"
        android:name="de.wuapps.moredays.ui.trophy.TrophyListFragment"
        android:label="trophy"
        tools:layout="@layout/trophy_list_fragment" />
    <fragment
        android:id="@+id/goalListFragment"
        android:name="de.wuapps.moredays.ui.goal.GoalListFragment"
        android:label="goal_list_fragment"
        tools:layout="@layout/goal_list_fragment" >
        <action
            android:id="@+id/navigation_goals_goal"
            app:destination="@id/goalFragment" />
    </fragment>
    <fragment
        android:id="@+id/challengeListFragment"
        android:name="de.wuapps.moredays.ui.challenge.ChallengeListFragment"
        android:label="challenge_list_fragment"
        tools:layout="@layout/challenge_list_fragment" >
        <action
            android:id="@+id/navgigation_challenges_challenge"
            app:destination="@id/challengeFragment" />
    </fragment>
    <fragment
        android:id="@+id/scaleListFragment"
        android:name="de.wuapps.moredays.ui.scale.ScaleListFragment"
        android:label="fragment_scale_list"
        tools:layout="@layout/fragment_scale_list" >
        <action
            android:id="@+id/navigation_scales_scale"
            app:destination="@id/scaleFragment" />
    </fragment>
    <fragment
        android:id="@+id/scaleFragment"
        android:name="de.wuapps.moredays.ui.scale.ScaleFragment"
        android:label="scale_fragment"
        tools:layout="@layout/scale_fragment">
        <argument
            android:name="scale"
            app:nullable="true"
            app:argType="de.wuapps.moredays.database.entity.Scale"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/navigation_journal"
        android:name="de.wuapps.moredays.ui.journal.JournalListFragment"
        android:label="journal_list_fragment"
        tools:layout="@layout/journal_list_fragment" >
        <action
            android:id="@+id/navigation_journal_day"
            app:destination="@id/journalFragment" />
    </fragment>
    <fragment
        android:id="@+id/journalFragment"
        android:name="de.wuapps.moredays.ui.journal.JournalFragment"
        android:label="journal_fragment"
        tools:layout="@layout/journal_fragment">
        <argument
            android:name="journalDay"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
</navigation>