<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MoreDays" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/orange700</item>
        <item name="colorPrimaryVariant">@color/orange700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/orangeBrown900</item>
        <item name="colorSecondaryVariant">@color/gray400</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/orange700</item>

        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/almostWhite</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/darkRed</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:textColorPrimary">@color/almostWhite</item>

        <!-- defined in attrs.xml -->
        <item name="hintTextColor">@color/white</item>
        <item name="hintBackgroundColor">@color/gray900</item>
        <item name="textOnHelpCardColor">@color/white</item>
        <item name="helpCardColor">@color/gray900</item>
        <item name="trophyTextColor">@color/black</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>



