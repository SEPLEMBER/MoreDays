<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MoreDays" parent="Theme.MaterialComponents.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/orange500</item>
        <item name="colorPrimaryVariant">@color/orange100</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lime500</item>
        <item name="colorSecondaryVariant">@color/gray400</item>

        <item name="android:colorBackground">@color/almostWhite</item>
        <item name="colorError">@color/darkRed</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/orange700</item>

        <!-- named colors of this app, defined in attrs.xml -->
        <item name="hintTextColor">@color/gray600</item>
        <item name="hintBackgroundColor">@color/almostWhite</item>
        <item name="textOnHelpCardColor">@color/gray900</item>
        <item name="helpCardColor">@color/gray200</item>
        <item name="trophyTextColor">@color/black</item>

     <!--   <item name="android:textColorPrimary">@color/gray900</item>-->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation
        duration. -->
        <item name="windowSplashScreenBackground">@color/gray900</item>

        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated
             drawable. One of these is required. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_foreground</item>
        <!-- Required for animated icons. -->
        <item name="windowSplashScreenAnimationDuration">100</item>

        <!-- Set the theme of the Activity that directly follows your splash
        screen. This is required. -->
        <item name="postSplashScreenTheme">@style/Theme.MoreDays</item>
    </style>

    <style name="Theme.MoreDays.ImagePicker" parent="Theme.MoreDays">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>



</resources>
