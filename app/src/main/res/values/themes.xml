<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MoreDays" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/orange500</item>
        <item name="colorPrimaryVariant">@color/orange100</item>
        <item name="colorOnPrimary">@color/gray900</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lime500</item>
        <item name="colorSecondaryVariant">@color/gray400</item>
        <item name="colorOnSecondary">@color/gray600</item>

        <item name="android:colorBackground">@color/almostWhite</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gray900</item>
        <item name="colorError">@color/darkRed</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/orange700</item>

        <!-- defined in attrs.xml -->
        <item name="hintTextColor">@color/gray600</item>
        <item name="hintBackgroundColor">@color/almostWhite</item>
        <item name="textOnHelpCardColor">@color/gray900</item>
        <item name="helpCardColor">@color/gray200</item>
        <item name="trophyTextColor">@color/black</item>

        <item name="fontFamily">@font/montserrat_regular</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>


    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>


</resources>