<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_personal_header">

        <EditTextPreference
            app:key="@string/preferences_name_key"
            app:title="@string/settings_your_name_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="@string/preferences_dark_mode_key"
            app:title="@string/settings_dark_mode"
            app:summaryOff="@string/settings_dark_mode_off"
            app:summaryOn="@string/settings_dark_mode_on"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_start_header">

        <SwitchPreferenceCompat
            app:key="@string/preferences_start_fragment_key"
            app:title="@string/settings_start_home_title"
            app:summaryOff="@string/settings_start_home_title_off"
            app:summaryOn="@string/settings_start_home_title_on"/>

    </PreferenceCategory>

</PreferenceScreen>