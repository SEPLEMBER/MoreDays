<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:key="@string/preferences_name_key"
        app:title="@string/settings_your_name_title"
        app:useSimpleSummaryProvider="true" />

    <DropDownPreference
        android:defaultValue=""
        android:entries="@array/entriesLanguage"
        android:entryValues="@array/valuesLanguage"
        app:key="@string/preferences_language_key"
        app:title="@string/settings_language"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:key="@string/preferences_dark_mode_key"
        app:summaryOff="@string/no"
        app:summaryOn="@string/yes"
        android:defaultValue="true"
        app:title="@string/settings_dark_mode" />

    <SwitchPreferenceCompat
        app:key="@string/preferences_show_confetti_key"
        app:summaryOff="@string/no"
        app:summaryOn="@string/yes"
        app:title="@string/settings_show_confetti" />

    <SwitchPreferenceCompat
        app:key="@string/preferences_show_completed_animation_key"
        app:summaryOff="@string/no"
        app:summaryOn="@string/yes"
        android:defaultValue="false"
        app:title="@string/settings_show_completed_animation" />

    <DropDownPreference
        android:entries="@array/entriesAffirmationTrigger"
        android:entryValues="@array/valuesAffirmationTrigger"
        android:defaultValue="never"
        app:key="@string/preferences_affirmation_trigger_key"
        app:title="@string/settings_affirmation_trigger"
        app:useSimpleSummaryProvider="true" />

    <SeekBarPreference
        android:defaultValue="80"
        android:max="100"
        app:key="@string/preferences_affirmation_threshold_key"
        app:min="1"
        app:showSeekBarValue="true"
        app:title="@string/settings_affirmation_threshold" />

    <DropDownPreference
        android:entries="@array/entriesAffirmationDuration"
        android:entryValues="@array/valuesAffirmationDuration"
        android:defaultValue="3000"
        app:key="@string/preferences_affirmation_duration_key"
        app:title="@string/settings_affirmation_duration"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="@string/preferences_show_percentage_key"
        android:defaultValue="true"
        app:summaryOff="@string/settings_style_inner_circle_off"
        app:summaryOn="@string/settings_style_inner_circle_on"
        app:title="@string/settings_style_inner_circle" />

    <EditTextPreference
        app:key="@string/preferences_journal_template_key"
        app:title="@string/settings_journal_template"
        app:useSimpleSummaryProvider="true" />
    <DropDownPreference
        android:entries="@array/entriesFrequencyJournal"
        android:entryValues="@array/valuesFrequencyJournal"
        app:key="@string/preferences_frequency_journal_entries_key"
        app:title="@string/settings_frequency_journal_entries"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="@string/preferences_notification_key"
        app:summaryOff="@string/no"
        app:summaryOn="@string/yes"
        app:title="@string/settings_notification_title" />

    <de.wuapps.moredays.ui.tools.settings.TimePickerPreference
        app:dependency="@string/preferences_notification_key"
        android:layout="@layout/preference_time_picker"
        android:selectable="true" />
    <EditTextPreference
        app:dependency="@string/preferences_notification_key"
        app:defaultValue="@string/settings_notification_text_default_value"
        app:key="@string/preferences_notification_text_key"
        app:title="@string/settings_notification_text_title"
        app:useSimpleSummaryProvider="true" />


</PreferenceScreen>
