<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">


<EditTextPreference
            app:key="@string/preferences_name_key"
            app:title="@string/settings_your_name_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="@string/preferences_dark_mode_key"
            app:title="@string/settings_dark_mode"
            app:summaryOff="@string/settings_dark_mode_off"
            app:summaryOn="@string/settings_dark_mode_on"/>

        <SwitchPreferenceCompat
            app:key="@string/preferences_hide_confetti_key"
            app:title="@string/settings_hide_confetti"
            app:summaryOff="@string/settings_hide_confetti_off"
            app:summaryOn="@string/settings_hide_confetti_on"/>

        <SwitchPreferenceCompat
            app:key="@string/preferences_hide_completed_animation_key"
            app:title="@string/settings_hide_completed_animation"
            app:summaryOff="@string/settings_hide_completed_animation_off"
            app:summaryOn="@string/settings_hide_completed_animation_on"/>

        <SwitchPreferenceCompat
            app:key="@string/preferences_show_percentage_key"
            app:title="@string/settings_style_inner_circle"
            app:summaryOff="@string/settings_style_inner_circle_off"
            app:summaryOn="@string/settings_style_inner_circle_on"/>
        <DropDownPreference
                app:key="@string/preferences_frequency_journal_entries_key"
                app:title="@string/settings_frequency_journal_entries"
            android:entries="@array/entriesFrequencyJournal"
            app:useSimpleSummaryProvider="true"
            android:entryValues="@array/valuesFrequencyJournal"
            />


</PreferenceScreen>